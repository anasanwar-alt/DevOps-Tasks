# Multi-stage build.
#
# Stage 1 (builder) has the full toolchain: node:22 + the TypeScript compiler.
# It compiles src/*.ts -> dist/*.js.
#
# Stage 2 (runtime) starts FROM a clean, minimal node:22-alpine and copies ONLY
# the compiled dist/ out of the builder. The compiler, the dev dependencies, the
# source, and the npm cache never exist in the final image. Because this app has
# zero runtime dependencies (Node's built-in http only), the runtime stage needs
# nothing but the compiled output.

# ---- Stage 1: build ----
FROM node:22 AS builder
WORKDIR /app
COPY package.json tsconfig.json ./
RUN npm install
COPY src ./src
RUN npm run build

# ---- Stage 2: runtime ----
FROM node:22-alpine
WORKDIR /app

# Copy only the build output from the builder stage.
COPY --from=builder /app/dist ./dist

ENV PORT=3000
EXPOSE 3000
USER node
CMD ["node", "dist/server.js"]
