# Copy this file to .env before running `docker compose up`:
#
#   cp .env.example .env
#
# .env is gitignored; this template is committed. That split is the point — the
# repo documents WHICH variables are required without ever publishing values.
# Compose reads .env automatically from the directory holding docker-compose.yml.
POSTGRES_USER=day6
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=day6
