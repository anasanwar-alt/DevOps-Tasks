    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@types/node": "22.7.5",
    "eslint": "9.13.0",
    "globals": "15.11.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0"
  }
}