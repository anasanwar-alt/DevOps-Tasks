{
  "name": "day5-app",
  "version": "1.0.0",
  "description": "Day 5 — Day 3's app, now driven through a lint/test/build/push/deploy pipeline",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "lint": "eslint .",
    "build": "tsc -p tsconfig.json",
