{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // Tests are compiled by tsconfig.test.json instead, so they never reach dist/
  // and therefore never reach the production image.
  "exclude": ["src/**/*.test.ts"]
}